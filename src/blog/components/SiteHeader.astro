---
import SharedHeader from '../../components/SiteHeader.astro';
import { navItems } from '@/lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  return path === target || (target === '/blog/posts' && path.startsWith('/blog/posts/')) || (target === '/blog/tags' && path.startsWith('/blog/tags/'));
};
---

<SharedHeader />
<nav class="blog-navigation site-width" aria-label="Blog navigation">
  {navItems.map((item) => (
    <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>
