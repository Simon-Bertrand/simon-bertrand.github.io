---
import { site, withBase } from '@/lib/site';
---

<footer class="mt-16 border-t border-[color:var(--border)] bg-[color:var(--bg-muted)]/45">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm text-[color:var(--text-muted)] sm:px-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:px-8">
    <div class="flex max-w-2xl items-start gap-4">
      <img src={site.avatar} alt="" class="h-12 w-12 rounded-md object-cover" loading="lazy" />
      <div>
        <p class="font-semibold text-[color:var(--text)]">{site.title}</p>
        <p class="mt-1">Systems, numerics, AI and performance experiments.</p>
        <p class="mt-3">© {new Date().getFullYear()} {site.author}</p>
      </div>
    </div>
    <p class="flex items-center gap-4 lg:justify-end">
      <a href={withBase('/rss.xml')} class="hover:text-[color:var(--text)]">RSS</a>
      <a href={site.github} class="hover:text-[color:var(--text)]">GitHub</a>
      <a href={`mailto:${site.email}`} class="hover:text-[color:var(--text)]">Email</a>
    </p>
  </div>
</footer>
