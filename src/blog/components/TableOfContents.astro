---
const { headings } = Astro.props as { headings: Array<{ depth: number; slug: string; text: string }> };
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{items.length > 0 && (
  <aside class="table-of-contents">
    <h2>Contents</h2>
    <nav class="mt-4">
      <ol class="space-y-3 text-sm leading-6 text-[color:var(--text-muted)]">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? 'toc-child' : ''}>
            <a href={`#${heading.slug}`} class="hover:text-[color:var(--text)]">
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </aside>
)}