---
import { formatDate } from '@/lib/content';
import { withBase } from '@/lib/site';
import TagPill from './TagPill.astro';

const { entry } = Astro.props as { entry: any };
---

<article class="article-card">
  <div class="article-card-meta">
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
    <span>{entry.collection === 'posts' ? 'Article' : 'Note'}</span>
  </div>
  <h3>
    <a href={withBase(entry.collection === 'posts' ? `/posts/${entry.slug}/` : `/notes/${entry.slug}/`)}>{entry.data.title}</a>
  </h3>
  <p>{entry.data.description}</p>
  {entry.data.tags.length > 0 && (
    <div class="article-tags">
      {entry.data.tags.slice(0, 4).map((tag: string) => <TagPill tag={tag} />)}
    </div>
  )}
</article>
