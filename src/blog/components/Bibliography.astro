---
const { items } = Astro.props as {
  items: Array<{ id: string; author: string; title: string; year: string; url?: string }>;
};
---

{items.length > 0 && (
  <section class="mt-12 border-t border-[color:var(--border)] pt-8">
    <h2 class="text-lg font-semibold tracking-tight text-[color:var(--text)]">References</h2>
    <ol class="mt-4 space-y-4 text-sm leading-7 text-[color:var(--text-muted)]">
      {items.map((item) => (
        <li id={`citation-${item.id}`} class="scroll-mt-24">
          <span class="font-medium text-[color:var(--text)]">{item.author}.</span> {item.title}. {item.year}.
          {item.url && (
            <>
              {' '}
              <a href={item.url} class="hover:text-[color:var(--text)]">{item.url}</a>
            </>
          )}
        </li>
      ))}
    </ol>
  </section>
)}