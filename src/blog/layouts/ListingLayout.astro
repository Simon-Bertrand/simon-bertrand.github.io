---
import BaseLayout from './BaseLayout.astro';

const { title, description } = Astro.props as { title: string; description: string };
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <header class="max-w-3xl">
      <h1 class="text-3xl font-semibold text-[color:var(--text)] sm:text-4xl">{title}</h1>
     
    </header>

    <div class="mt-10">
      <slot />
    </div>
  </section>
</BaseLayout>
