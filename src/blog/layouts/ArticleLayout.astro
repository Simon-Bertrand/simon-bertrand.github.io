---
import Backlinks from '@/components/Backlinks.astro';
import Bibliography from '@/components/Bibliography.astro';
import ArticleNav from '@/components/ArticleNav.astro';
import TagPill from '@/components/TagPill.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { site } from '@/lib/site';
import BaseLayout from './BaseLayout.astro';

const {
  title,
  description,
  date,
  updated,
  tags = [],
  headings = [],
  readingTime,
  previousEntry,
  nextEntry,
  backlinks = [],
  bibliography = [],
  type = 'article',
  notes = [],
  notebookSource,
} = Astro.props as {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  headings?: Array<{ depth: number; slug: string; text: string }>;
  readingTime?: string;
  previousEntry?: { slug: string; data: { title: string } };
  nextEntry?: { slug: string; data: { title: string } };
  backlinks?: Array<{ href: string; slug: string; data: { title: string; description: string } }>;
  bibliography?: Array<{ id: string; author: string; title: string; year: string; url?: string }>;
  type?: 'article' | 'note';
  notes?: Array<{ label: string; value: string }>;
  notebookSource?: string;
};

const colabUrl = notebookSource
  ? `https://colab.research.google.com/github/${site.notebookRepository}/blob/${site.notebookBranch}/${notebookSource
      .replace(/^\/+/, '')
      .split('/')
      .map(encodeURIComponent)
      .join('/')}`
  : undefined;
---

<BaseLayout title={title} description={description} type="article">
  <div class="mx-auto max-w-[92rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,16rem)_minmax(0,54rem)_minmax(0,16rem)] xl:grid-cols-[minmax(0,18rem)_minmax(0,60rem)_minmax(0,18rem)]">
      <div class="hidden lg:block"></div>

      <article class="min-w-0">
        <header class="mb-8 border-b border-[color:var(--border)] pb-8">
          <div class="flex flex-wrap items-center gap-3 text-sm text-[color:var(--text-muted)]">
            <time datetime={date.toISOString()}>{date.toLocaleDateString('en', { year: 'numeric', month: 'short', day: '2-digit' })}</time>
            {updated && <span>Updated {updated.toLocaleDateString('en', { year: 'numeric', month: 'short', day: '2-digit' })}</span>}
            {readingTime && <span>{readingTime}</span>}
            <span class="rounded-md border border-[color:var(--border)] px-2 py-1 text-xs uppercase tracking-[0.2em]">{type}</span>
          </div>

          <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[color:var(--text)] sm:text-4xl">{title}</h1>
          <p class="mt-4 max-w-3xl text-lg leading-8 text-[color:var(--text-muted)]">{description}</p>

          {tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {tags.map((tag) => <TagPill tag={tag} />)}
            </div>
          )}

          {colabUrl && (
            <div class="mt-6">
              <a href={colabUrl} target="_blank" rel="noopener noreferrer" class="colab-button" aria-label="Open the notebook in Google Colab">
                <svg viewBox="0 0 48 28" aria-hidden="true" class="h-4 w-7">
                  <path
                    d="M18.9 22.1c-2.7 2.2-6.8 2.5-10.2.8-5-2.5-6.7-8.4-3.9-13.2 2.8-4.7 8.9-6.3 13.6-3.5 1.5.9 2.8 2.1 3.7 3.5"
                    fill="none"
                    stroke="#f9ab00"
                    stroke-linecap="round"
                    stroke-width="5"
                  />
                  <path
                    d="M29.1 5.9c2.7-2.2 6.8-2.5 10.2-.8 5 2.5 6.7 8.4 3.9 13.2-2.8 4.7-8.9 6.3-13.6 3.5-1.5-.9-2.8-2.1-3.7-3.5"
                    fill="none"
                    stroke="#e8710a"
                    stroke-linecap="round"
                    stroke-width="5"
                  />
                  <path
                    d="M18.8 13.9c1.8-3.8 4.2-5.7 7.2-5.7s5.4 1.9 7.2 5.7c-1.8 3.8-4.2 5.7-7.2 5.7s-5.4-1.9-7.2-5.7Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="3"
                  />
                </svg>
                <span>Colab</span>
              </a>
            </div>
          )}
        </header>

        <div class="prose prose-neutral max-w-none prose-headings:font-semibold prose-a:break-words prose-pre:my-6">
          <slot />
        </div>

        {notes.length > 0 && (
          <section class="mt-12 border-t border-[color:var(--border)] pt-8">
            <h2 class="text-lg font-semibold tracking-tight text-[color:var(--text)]">Notes</h2>
            <dl class="mt-4 space-y-3 text-sm leading-6 text-[color:var(--text-muted)]">
              {notes.map((note) => (
                <div class="surface rounded-lg p-4">
                  <dt class="font-medium text-[color:var(--text)]">{note.label}</dt>
                  <dd class="mt-1">{note.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <ArticleNav previousEntry={previousEntry} nextEntry={nextEntry} />
        <Backlinks entries={backlinks} />
        <Bibliography items={bibliography} />
      </article>

      <div class="hidden lg:block">
        <TableOfContents headings={headings} />
      </div>
    </div>
  </div>
</BaseLayout>
