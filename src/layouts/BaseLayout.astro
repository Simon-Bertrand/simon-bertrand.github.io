---
import { profile } from "../data/params";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeScript from "../components/ThemeScript.astro";
import "../style/design.css";
import "../style/index.css";

const { title = "CV", description = profile.summary } = Astro.props;
const meta = {
  title: `${profile.name} — ${profile.qualification}${title === "CV" ? "" : ` — ${title}`}`,
  description,
  keywords:
    "data science, AI, development, machine learning, computer vision, signals, images, processing, telecom physique strasbourg, science des données, IA, développement, apprentissage automatique, vision par ordinateur, signaux, traitement",
};
---

<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="title" content={meta.title} />
    <meta name="description" content={meta.description} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="keywords" content={meta.keywords} />
    <meta name="robots" content="index, follow" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="language" content="French" />
    <meta name="revisit-after" content="5 days" />
    <meta name="author" content="Simon Bertrand" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
    <meta name="msapplication-TileColor" content="#f1f1f1" />
    <meta name="theme-color" content="#11161c" />
    <ThemeScript />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P4CBYH4019"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-P4CBYH4019");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Aller au contenu</a>
    <SiteHeader />
    <main id="content" class="page site-width">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
