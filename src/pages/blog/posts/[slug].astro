---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { entryHref, headingsFromHtml, isPublished, readingStats } from '@/lib/content';
import { findBacklinks } from '@/lib/backlinks';

export async function getStaticPaths() {
  const entries = await getCollection('posts', isPublished);
  return entries.map((entry: CollectionEntry<'posts'>) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'posts'> };
const { Content, headings } = await render(entry);
const articleHeadings = headings.length > 0 ? headings : headingsFromHtml(entry.body);
const allEntries = [
  ...(await getCollection('posts', isPublished)),
  ...(await getCollection('notes', isPublished)),
].sort((left, right) => right.data.date.getTime() - left.data.date.getTime());
const postEntries = allEntries.filter((candidate): candidate is CollectionEntry<'posts'> => candidate.collection === 'posts');
const currentIndex = postEntries.findIndex((candidate) => candidate.slug === entry.slug);
const previousEntry = currentIndex > 0 ? postEntries[currentIndex - 1] : undefined;
const nextEntry = currentIndex >= 0 && currentIndex < postEntries.length - 1 ? postEntries[currentIndex + 1] : undefined;
const backlinks = findBacklinks(entry.slug, allEntries)
  .filter((candidate) => candidate.slug !== entry.slug)
  .map((candidate) => ({
    href: entryHref(candidate),
    slug: candidate.slug,
    data: {
      title: candidate.data.title,
      description: candidate.data.description,
    },
  }));
const stats = readingStats(entry.body);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  updated={entry.data.updated}
  tags={entry.data.tags}
  headings={articleHeadings}
  readingTime={stats.label}
  previousEntry={previousEntry}
  nextEntry={nextEntry}
  backlinks={backlinks}
  bibliography={entry.data.bibliography}
  notebookSource={entry.data.source}
  type="article"
>
  <Content />
</ArticleLayout>
