---
import ArticleCard from '@/components/ArticleCard.astro';
import ListingLayout from '@/layouts/ListingLayout.astro';
import { getPublishedPosts } from '@/lib/content';

const posts = await getPublishedPosts();
---

<ListingLayout title="Posts" description="Technical articles on scientific computing, software and machine learning.">
  <div class="writing-list">
    {posts.map((entry) => <ArticleCard entry={entry} />)}
  </div>
</ListingLayout>