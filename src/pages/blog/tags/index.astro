---
import ListingLayout from '@/layouts/ListingLayout.astro';
import { getPublishedNotes, getPublishedPosts } from '@/lib/content';
import { withBase } from '@/lib/site';

const [posts, notes] = await Promise.all([getPublishedPosts(), getPublishedNotes()]);
const tagMap = new Map<string, number>();

for (const entry of [...posts, ...notes]) {
  for (const tag of entry.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagMap.entries()].sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0]));
---

<ListingLayout title="Tags" description="A lightweight tag index for navigating the technical knowledge base.">
  <div class="flex flex-wrap gap-3">
    {tags.map(([tag, count]) => (
      <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)} class="surface inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm text-[color:var(--text)] hover:border-[color:var(--accent)]">
        <span>{tag}</span>
        <span class="text-[color:var(--text-muted)]">{count}</span>
      </a>
    ))}
  </div>
</ListingLayout>
