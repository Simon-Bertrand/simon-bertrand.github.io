---
import ArticleCard from '@/components/ArticleCard.astro';
import ListingLayout from '@/layouts/ListingLayout.astro';
import { getPublishedNotes, getPublishedPosts } from '@/lib/content';

export async function getStaticPaths() {
  const [posts, notes] = await Promise.all([getPublishedPosts(), getPublishedNotes()]);
  const entries = [...posts, ...notes];
  const tags = new Set(entries.flatMap((entry) => entry.data.tags));

  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props as { tag: string };
const [posts, notes] = await Promise.all([getPublishedPosts(), getPublishedNotes()]);
const entries = [...posts, ...notes].filter((entry) => entry.data.tags.includes(tag));
---

<ListingLayout title={`Tag: ${tag}`} description={`All published articles and notes tagged with ${tag}.`}>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {entries.map((entry) => <ArticleCard entry={entry} />)}
  </div>
</ListingLayout>