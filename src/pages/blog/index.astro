---
import ArticleCard from '@/components/ArticleCard.astro';
import ListingLayout from '@/layouts/ListingLayout.astro';
import { getPublishedNotes, getPublishedPosts, sortEntriesByDateDesc } from '@/lib/content';
import { withBase } from '@/lib/site';

const [posts, notes] = await Promise.all([getPublishedPosts(), getPublishedNotes()]);
const latest = sortEntriesByDateDesc([...posts, ...notes]).slice(0, 6);
---

<ListingLayout title="Technical notes" description="Articles on scientific computing, low-level performance and machine learning. Derivations, experiments and implementation notes from my work.">
  <section>
    <div class="blog-section-heading">
      <h2>Latest writing</h2>
      <a href={withBase('/posts/')}>All articles →</a>
    </div>
    <div class="writing-list">
      {latest.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>
</ListingLayout>
