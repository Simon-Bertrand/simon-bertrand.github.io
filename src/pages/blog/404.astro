---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
---

<BaseLayout title="Not found" description="The requested page could not be found.">
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <h1 class="text-4xl font-semibold tracking-tight text-[color:var(--text)]">Page not found</h1>
    <p class="mt-4 text-lg text-[color:var(--text-muted)]">Try the latest posts, notes, or search index.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={withBase('/posts/')} class="rounded-md bg-[color:var(--accent)] px-4 py-2 text-sm font-medium text-white">Posts</a>
      <a href={withBase('/search/')} class="rounded-md border border-[color:var(--border)] px-4 py-2 text-sm font-medium text-[color:var(--text)]">Search</a>
    </div>
  </section>
</BaseLayout>
