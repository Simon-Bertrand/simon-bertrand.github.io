---
import TagPill from '@/components/TagPill.astro';
import ListingLayout from '@/layouts/ListingLayout.astro';
import { entryHref, entryKind, formatDate, getPublishedNotes, getPublishedPosts, sortEntriesByDateDesc, type ContentEntry } from '@/lib/content';

const [posts, notes] = await Promise.all([getPublishedPosts(), getPublishedNotes()]);
const entries: ContentEntry[] = sortEntriesByDateDesc([...posts, ...notes]);
const grouped = entries.reduce((years, entry) => {
  const year = entry.data.date.getFullYear();
  const list = years.get(year) ?? [];
  list.push(entry);
  years.set(year, list);
  return years;
}, new Map<number, ContentEntry[]>());
const years = [...grouped.entries()].sort((left, right) => right[0] - left[0]);
---

<ListingLayout title="Archives" description="A chronological map of articles and notes.">
  <div class="space-y-10">
    {years.map(([year, yearEntries]) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <ol class="mt-4 divide-y divide-[color:var(--border)] border-y border-[color:var(--border)]">
          {yearEntries.map((entry: ContentEntry) => (
            <li class="grid gap-3 py-5 md:grid-cols-[8rem_minmax(0,1fr)_7rem] md:items-start">
              <time datetime={entry.data.date.toISOString()} class="text-sm text-[color:var(--text-muted)]">{formatDate(entry.data.date)}</time>
              <div>
                <a href={entryHref(entry)} class="text-lg font-semibold text-[color:var(--text)] hover:text-[color:var(--accent)]">{entry.data.title}</a>
                <p class="mt-2 text-sm leading-6 text-[color:var(--text-muted)]">{entry.data.description}</p>
                {entry.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {entry.data.tags.slice(0, 4).map((tag: string) => <TagPill tag={tag} />)}
                  </div>
                )}
              </div>
              <span class="justify-self-start rounded-md border border-[color:var(--border)] px-2 py-1 text-xs uppercase text-[color:var(--text-muted)] md:justify-self-end">{entryKind(entry)}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</ListingLayout>
