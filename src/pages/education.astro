---
import BaseLayout from "../layouts/BaseLayout.astro";
import { educationItems, thesis } from "../data/params";
import InstitutionLogo from "../components/InstitutionLogo.astro";
---

<BaseLayout title="Formation">
  <h1>Formation</h1>
  <ol class="cv-records">
    {educationItems.map((item, index) => (
      <li class="cv-record">
        <div class="cv-record-meta">
          <p>{item.date}</p>
          <InstitutionLogo src={item.src} alt={`Logo ${item.description}`} variant={item.logoVariant} />
        </div>
        <div>
          <h2>{item.title}</h2>
          <p class="cv-record-institution">{item.description}</p>
          <p>{item.option}</p>
          {index === 0 && (
            <div class="cv-thesis">
              <p>{thesis.title}</p>
              <p>Soutenance le {thesis.defenseDate}.</p>
              <a href={thesis.source} target="_blank" rel="noopener noreferrer">Consulter la thèse sur HAL ↗</a>
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>
