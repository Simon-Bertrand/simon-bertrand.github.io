---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/params";
import PublicationList from "../components/PublicationList.astro";

const technicalAreas = [
  ["Programmation", "Rust, Python, C#, C++, C, TypeScript, JavaScript"],
  [
    "Intelligence artificielle",
    "Deep Learning, Vision par ordinateur, Traitement du signal et des images, Statistiques",
  ],
  [
    "Outils Data Science",
    "PyTorch, TensorFlow, JAX, HF, Scipy, Scikit-Learn, Pandas, Polars, Statsmodels",
  ],
  ["Ingénierie logicielle", "Git, Docker, CI/CD, Tests, Bash, SSH"],
  ["Développement Web", "API REST, FastAPI, Next.js, React, HTML, CSS, Tailwind CSS"],
  ["Bases de données", "PostgreSQL, SQL, NoSQL, Redis"],
  [
    "Systèmes réseaux",
    "Linux, TCP/IP, UDP, DHCP, DNS, NAT, VPN, SSL/TLS, Reverse Proxy, HTTP, WebSocket",
  ],
  ["Sécurité, Rétro-ingénierie", "Chiffrement, Analyse statique, Analyse dynamique, Décompilation"],
  ["Électronique embarquée", "ESP32, Arduino, Raspberry Pi, EasyEDA, Fusion 360"],
];
---

<BaseLayout>
  <div class="cv-home">
    <header class="cv-intro">
      <p class="cv-eyebrow">Recherche appliquée & ingénierie</p>
      <h1>{profile.qualification}</h1>
      <p class="cv-specialties">{profile.specialties}</p>
      <p class="cv-summary">{profile.summary}</p>
      <nav class="cv-links" aria-label="Contact et profils scientifiques">
        <a href="https://www.linkedin.com/in/simonbertrand-engineering/" target="_blank" rel="noreferrer">Me contacter</a>
        <a href={profile.scholar} target="_blank" rel="noreferrer">Google Scholar</a>
        <a href="https://github.com/Simon-Bertrand" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <section class="cv-section" aria-labelledby="research-title">
      <h2 id="research-title">Recherche</h2>
      <p>
        Mes travaux doctoraux au CEA et à l’Université de Bordeaux ont porté sur
        le recalage d’images SAR et optiques pour la navigation de drones assistée
        par le terrain. Ils associent apprentissage profond, données d’observation
        de la Terre et calcul sur GPU.
      </p>
      <a href="https://github.com/Simon-Bertrand/MEOW" target="_blank" rel="noreferrer">MEOW : jeu de données et outils de recherche ↗</a>
    </section>

    <section class="cv-section" aria-labelledby="publications-title">
      <h2 id="publications-title">Publications</h2>
      <PublicationList />
    </section>

    <section class="cv-section" aria-labelledby="expertise-title">
      <h2 id="expertise-title">Domaines de travail</h2>
      <dl class="cv-expertise">
        <div>
          <dt>Intelligence artificielle</dt>
          <dd>Vision par ordinateur, apprentissage profond, recalage multimodal et IA générative.</dd>
        </div>
        <div>
          <dt>Calcul scientifique & HPC</dt>
          <dd>PyTorch, JAX, TensorFlow, calcul sur GPU A100 et H100, orchestration avec SLURM.</dd>
        </div>
        <div>
          <dt>Ingénierie logicielle</dt>
          <dd>Python, Rust, C et C++ ; outils scientifiques, tests, Docker et intégration continue.</dd>
        </div>
      </dl>
      <a href="/projects">Consulter les projets logiciels →</a>
    </section>

    <section class="cv-section" aria-labelledby="teaching-title">
      <h2 id="teaching-title">Enseignement & parcours</h2>
      <p>
        Plus de 100 heures d’enseignement à l’ENSEIRB-MATMECA en programmation C,
        Python et deep learning. Mon parcours comprend également des expériences
        en vision par ordinateur chez Thales et en analyse de données au laboratoire iCube.
      </p>
      <div class="cv-links">
        <a href="/experiences">Expériences →</a>
        <a href="/education">Formation →</a>
        <a href="/blog/">Articles techniques →</a>
      </div>
    </section>

    <details class="cv-section cv-skills">
      <summary>Compétences techniques détaillées</summary>
      <dl class="cv-expertise">
        {technicalAreas.map(([title, description]) => (
          <div>
            <dt>{title}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </details>
  </div>
</BaseLayout>
