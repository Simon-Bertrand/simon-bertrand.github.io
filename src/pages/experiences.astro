---
import BaseLayout from "../layouts/BaseLayout.astro";
import { experienceItems } from "../data/params";
import InstitutionLogo from "../components/InstitutionLogo.astro";
---

<BaseLayout title="Expériences">
  <h1>Expériences</h1>
  <ol class="cv-records">
    {experienceItems.map((item) => (
      <li class="cv-record">
        <div class="cv-record-meta">
          <p>{item.date}</p>
          {item.src && <InstitutionLogo src={item.src} alt={`Logo ${item.company}`} variant={item.logoVariant} />}
        </div>
        <div>
          <h2>{item.title}</h2>
          <p class="cv-record-institution">{item.company}</p>
          <p>{item.description}</p>
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>
