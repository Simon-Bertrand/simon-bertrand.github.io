---
import BaseLayout from "../layouts/BaseLayout.astro";
import logoPdf from "../assets/logoPdf.png";
---

<BaseLayout>
  <h1 class="text-center p-5">Ressources</h1>
  <div class="accordion">
    <details class="accordion__item">
      <summary class="accordion__button">Publications</summary>
      <div class="accordion__panel">
        <a class="flex" target="_blank" href="/storage/Article1-These.pdf" title="Publication CEA">
          <div class="pdf w-1/3" style={`background-image: url(${logoPdf.src})`}></div>
          <p class="my-auto w-2/3">
            Learning-Based SAR-Optical Registration for Navigation: Insights From a
            Multiyear, Multiseason Continental-Scale Dataset - CEA
          </p>
        </a>
      </div>
    </details>
    <details class="accordion__item">
      <summary class="accordion__button">Rapports de travaux</summary>
      <div class="accordion__panel">
        <a class="flex" target="_blank" href="/storage/Rapport-Thales.pdf" title="Rapport Thales">
          <div class="pdf w-1/3" style={`background-image: url(${logoPdf.src})`}></div>
          <p class="my-auto w-2/3">
            Rapport segmentation sémantique de vidéos par deep learning - Thales
          </p>
        </a>
        <a class="flex" target="_blank" href="/storage/Rapport-iCube.pdf" title="Rapport iCube">
          <div class="pdf w-1/3" style={`background-image: url(${logoPdf.src})`}></div>
          <p class="my-auto w-2/3">
            Rapport analyse de qualité des clusters non-supervisés - iCube
          </p>
        </a>
      </div>
    </details>
    <details class="accordion__item">
      <summary class="accordion__button">Tutoriels</summary>
      <div class="accordion__panel">
        <h4 class="text-center p-2 normal-case">
          Démonstration et implémentation du perceptron simple
        </h4>
        <div class="container-iframe">
          <iframe
            class="responsive-iframe mx-auto"
            src="https://www.youtube.com/embed/whm1VQsnIv4"
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </details>
  </div>
</BaseLayout>
